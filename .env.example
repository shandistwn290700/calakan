# ================================================
#  Konfigurasi CALAKAN
#  Salin file ini menjadi ".env" lalu sesuaikan.
# ================================================

# Port aplikasi (buka http://localhost:3000)
PORT=3000

# Koneksi MySQL / MariaDB (bawaan XAMPP: user root, tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=calakan

# Lama sesi login (hari)
SESSION_DAYS=14

# Email kontak untuk push notification (wajib format mailto:)
VAPID_SUBJECT=mailto:admin@sekolah.sch.id

# Isi 1 HANYA jika aplikasi dipasang di belakang reverse proxy (Nginx, Cloudflare Tunnel, dll.).
# Bila 1, alamat IP & HTTPS dibaca dari header X-Forwarded-*. Biarkan 0 bila diakses langsung.
TRUST_PROXY=0

# Zona waktu MySQL (WIB). WITA: +08:00, WIT: +09:00
DB_TIMEZONE=+07:00
